# Database
# 로컬 기본값은 sqlite:///./app.db이며, 배포 시 Neon 연결 문자열을 입력합니다.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication
# 배포 시 `python -c "import secrets; print(secrets.token_urlsafe(64))"`로 생성합니다.
SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
TEMPORARY_PASSWORD=replace_with_a_temporary_admin_password

# CORS (쉼표로 여러 프론트 주소 구분, 끝의 / 제외)
CORS_ORIGINS=https://your-project.vercel.app

# Cloudinary (갤러리 이미지 업로드)
# https://cloudinary.com/console 에서 확인
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
